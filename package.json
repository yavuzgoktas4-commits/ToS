{
  "name": "tos-guard-extension",
  "version": "1.0.0",
  "description": "Production-ready Chrome Extension (Manifest V3) for AI-powered Terms of Service & Privacy Policy Risk Analysis with Zero-Hallucination Quote Gatekeeper and Prompt Injection Defense.",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
